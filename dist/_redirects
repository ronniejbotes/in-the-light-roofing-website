# Redirects that exist on the live WordPress site and must be carried over,
# plus two repairs for links that are broken on the live site today.
#
# Format is Netlify/Cloudflare Pages `_redirects`. See DEPLOY.md for the
# nginx / Apache equivalents.

# --- redirects the live site already serves (verified with curl) ------------

# WordPress redirects the front page's own slug to the site root.
/home-in-the-light-roofing-final-update/   /                                             301
/home-in-the-light-roofing-final-update    /                                             301

# Yoast serves the sitemap index from /sitemap.xml.
/sitemap.xml                               /sitemap_index.xml                            301

# Feeds are disabled on the live site and redirect to the home page.
/feed/                                     /                                             301
/comments/feed/                            /                                             301

# Linked in-content from 21 pages; 301s to the real Center Valley page today.
/service-area/center-valley/               /service-area/center-valley-roofing-contractor/ 301

# --- repairs for links that are broken on the live site --------------------
# This URL is linked in-content from 4 pages and returns 404 today. Pointing it
# at the real Bethlehem page recovers those links. Nothing currently ranks on
# it, so there is no risk in creating the redirect.
/service-area/roofing-contractors-bethlehem-pa/  /service-area/roofers-bethlehem-pa/     301

# --- WordPress endpoints that no longer exist ------------------------------
# These are gone with WordPress. Sending them to the home page rather than a
# 404 avoids handing crawlers dead ends on URLs they may still have queued.
/wp-login.php                              /                                             301
/xmlrpc.php                                /                                             410
/wp-admin/*                                /                                             301

# --- asset repairs ----------------------------------------------------------
# Insurance.svg and INSURANCE.svg are two files on the live host that differ
# only in filename case: the same artwork at a 60x60 vs 80x80 viewBox. A
# case-insensitive filesystem cannot hold both, and because SVG scales (the
# rendered size is set in CSS) they are visually interchangeable. The lowercase
# URL is redirected to the stored file so neither URL 404s.
/wp-content/uploads/2023/12/Insurance.svg  /wp-content/uploads/2023/12/INSURANCE.svg  301

# The live site 301s the un-slashed form of every page URL. Hosts in DEPLOY.md
# do this automatically; this entry documents the one URL our own content
# links to without a slash.
/contact                                   /contact/                                  301

